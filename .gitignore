# .gitignore — Geode pen.
#
# Submoduleless by design: product checkouts live under products/ as peer
# standalone clones and are NEVER tracked by this repo. No gitlinks (mode
# 160000), no nested .git pollution in the index.
*
!.gitignore
!README.md
!LICENSE
!package.json
!mise.toml
!pitchfork.toml
!AGENTS.md
!bin/
!bin/**
!docs/
!docs/**
!tests/
!tests/**

# Keys & secrets — never commit
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.keyring
*.secret
.env
.env.*
!*.example
# pensctl audit-gitignore --fix (standard pollution)
.venv/
# pensctl audit-gitignore --fix (standard pollution)
venv/
# pensctl audit-gitignore --fix (standard pollution)
node_modules/
# pensctl audit-gitignore --fix (standard pollution)
__pycache__/
# pensctl audit-gitignore --fix (standard pollution)
dist/
# pensctl audit-gitignore --fix (standard pollution)
build/
# pensctl audit-gitignore --fix (standard pollution)
.cache/
# pensctl audit-gitignore --fix (standard pollution)
target/
# pensctl audit-gitignore --fix (standard pollution)
blobs/
# pensctl audit-gitignore --fix (standard pollution)
sessions/
# pensctl audit-gitignore --fix (standard pollution)
.next/
# pensctl audit-gitignore --fix (standard pollution)
.turbo/
