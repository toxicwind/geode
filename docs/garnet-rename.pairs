# geode rename: pairs -> garnet (deploy carver product)
# 2026-10-30 — cp of pens/geode/products/pairs to pens/geode/products/garnet
# Path-form only: pairs is a high-collision token (paired, key-pair, Pair<T>).

substr: pens/geode/products/pairs -> pens/geode/products/garnet
substr: geode/products/pairs -> geode/products/garnet
substr: "products/pairs/" -> "products/garnet/"

# Never rewrite bare "pairs"/"Pairs" — ordinary prose + --pairs CLI flag + .pairs convention files stay.
# word: pairs -> garnet   # INTENTIONALLY OUT — see pairs→dediops high-collision rules

exclude: --pairs
exclude: pairs-file
exclude: rename.pairs
